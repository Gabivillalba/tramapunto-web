# TRAMA. — variables de entorno (Vercel → Project → Settings → Environment Variables)
# Copiá los valores reales; nunca commitees el .env real.

# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── MercadoPago (cobro en Argentina) ──
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TOKEN_ENC_KEY=
MP_WEBHOOK_SECRET=

# ── Gumroad (cobro internacional de TRAMA. LABS, merchant of record) ──
# URL del producto de membresía mensual (USD 19). Ej: https://gabi.gumroad.com/l/trama-labs
GUMROAD_PRODUCT_URL=
# Access token del backend (verifica ventas por API + registra webhooks). Settings → Advanced → Applications.
GUMROAD_ACCESS_TOKEN=
# ID del vendedor (seller_id) para validar que el ping es tuyo (opcional pero recomendado).
GUMROAD_SELLER_ID=

# ── Cloudflare R2 (videos + fotos de muestra) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ── Email (Resend) ──
RESEND_API_KEY=

# ── Precios (fallback; se editan desde el admin / tabla config) ──
PRECIO_BOLSA=4900
PRECIO_CAMPANIA=25000
PRECIO_LABS=30000
PRIMER_GRATIS=true

# ── LABS: flag de apertura (también en config.labs_abierto) ──
LABS_ABIERTO=false

# ── Varios ──
SITE_URL=https://www.tramapunto.com
ADMIN_PASS=
CRON_SECRET=
