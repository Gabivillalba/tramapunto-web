# TRAMA. — variables de entorno (Vercel → Project → Settings → Environment Variables)
# Copiá los valores reales; nunca commitees el .env real.

# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── MercadoPago (cobro en Argentina) ──
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TOKEN_ENC_KEY=
MP_WEBHOOK_SECRET=

# ── Paddle (cobro internacional de TRAMA. LABS, merchant of record) ──
# PADDLE_ENV: 'sandbox' mientras probás, 'production' en vivo.
PADDLE_ENV=sandbox
# Client-side token (público, va al checkout). Sandbox: test_... / Vivo: live_...
PADDLE_CLIENT_TOKEN=
# API key del backend (server-side). Sandbox: pdl_sdbx_... / Vivo: pdl_live_...
PADDLE_API_KEY=
# Price ID del precio mensual de LABS (empieza con pri_).
PADDLE_PRICE_ID=
# Secret de la notification destination (webhook). Empieza con ntfset_/pdl_ntfset_.
PADDLE_WEBHOOK_SECRET=

# ── Cloudflare R2 (videos + fotos de muestra) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ── Email (Resend) ──
RESEND_API_KEY=

# ── Precios (fallback; se editan desde el admin / tabla config) ──
PRECIO_BOLSA=4900
PRECIO_CAMPANIA=25000
PRECIO_LABS=30000
PRIMER_GRATIS=true

# ── LABS: flag de apertura (también en config.labs_abierto) ──
LABS_ABIERTO=false

# ── Varios ──
SITE_URL=https://www.tramapunto.com
ADMIN_PASS=
CRON_SECRET=
